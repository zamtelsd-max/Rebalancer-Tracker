// ZLMS — Zamtel Liquidity Management System
// Prisma Schema — SQLite-compatible (enums as String)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Role: SUPER_ADMIN | TDE | MASTER_AGENT | REBALANCER | AGENT
// AgentStatus: ACTIVE | FLAGGED | SUSPENDED
// RequestStatus: PENDING | APPROVED | FLAGGED | CANCELLED | COMPLETED
// RequestType: CASH | FLOAT | BOTH
// AlertLevel: GREEN | YELLOW | ORANGE | RED
// BurnStatus: ACTIVE | COMPLETED | EXPIRED
// TxnType: CASH_IN | CASH_OUT
// TxnSource: CORE_SYNC | TRN_SUBMISSION | CSV_IMPORT
// CommissionStatus: DRAFT | SUBMITTED | APPROVED
// DisputeStatus: OPEN | IN_REVIEW | RESOLVED | DISMISSED

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  pin       String
  role      String // Role enum
  name      String
  zone      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  masterAgent MasterAgent?
  rebalancer  Rebalancer?
  auditLogs   AuditLog[]
  disputes    Dispute[]
}

model MasterAgent {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  name             String
  zone             String
  floatPoolBalance Float    @default(0)
  createdAt        DateTime @default(now())

  agents      Agent[]
  rebalancers Rebalancer[]
  commissions Commission[]
}

model Rebalancer {
  id            String      @id @default(cuid())
  userId        String      @unique
  user          User        @relation(fields: [userId], references: [id])
  name          String
  zone          String
  cashHolding   Float       @default(0)
  masterAgentId String
  masterAgent   MasterAgent @relation(fields: [masterAgentId], references: [id])
  createdAt     DateTime    @default(now())

  rebalanceTransactions RebalanceTransaction[]
  rebalanceRequests     RebalanceRequest[]
  observations          RebalancerObservation[]
}

model Agent {
  id                   String       @id @default(cuid())
  businessName         String
  msisdn               String       @unique
  gpsLat               Float
  gpsLng               Float
  geofenceRadiusM      Int          @default(100)
  qrCodeToken          String       @unique @default(cuid())
  floatBalance         Float        @default(0)
  cashBalance          Float        @default(0)
  lurScore             Float?
  casScore             Float?
  requestLocked        Boolean      @default(false)
  status               String       @default("ACTIVE") // AgentStatus
  lastRebalancedAt     DateTime?
  masterAgentId        String?
  masterAgent          MasterAgent? @relation(fields: [masterAgentId], references: [id])
  assignedRebalancerId String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  rebalanceRequests     RebalanceRequest[]
  rebalanceTransactions RebalanceTransaction[]
  burnDownTrackers      BurnDownTracker[]
  moneyTransactions     AgentMoneyTransaction[]
  trnSubmissions        TrnSubmission[]
  observations          RebalancerObservation[]
}

model RebalanceRequest {
  id              String      @id @default(cuid())
  agentId         String
  agent           Agent       @relation(fields: [agentId], references: [id])
  rebalancerId    String?
  rebalancer      Rebalancer? @relation(fields: [rebalancerId], references: [id])
  amountRequested Float
  amountApproved  Float?
  type            String      @default("BOTH") // RequestType
  status          String      @default("PENDING") // RequestStatus
  lurAtRequest    Float?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  transaction RebalanceTransaction?
}

model RebalanceTransaction {
  id                String           @id @default(cuid())
  requestId         String           @unique
  request           RebalanceRequest @relation(fields: [requestId], references: [id])
  rebalancerId      String
  rebalancer        Rebalancer       @relation(fields: [rebalancerId], references: [id])
  agentId           String
  agent             Agent            @relation(fields: [agentId], references: [id])
  cashAmount        Float            @default(0)
  floatAmount       Float            @default(0)
  gpsLatAtDispense  Float?
  gpsLngAtDispense  Float?
  distanceFromAgent Float?
  qrScanVerified    Boolean          @default(false)
  otpVerified       Boolean          @default(false)
  dispensedAt       DateTime?
  burnTargetDate    DateTime?
  burnTargetAmount  Float?
  createdAt         DateTime         @default(now())

  burnDownTracker BurnDownTracker?
  observation     RebalancerObservation?
}

model BurnDownTracker {
  id              String               @id @default(cuid())
  txnId           String               @unique
  transaction     RebalanceTransaction @relation(fields: [txnId], references: [id])
  agentId         String
  agent           Agent                @relation(fields: [agentId], references: [id])
  initialAmount   Float
  currentUtilized Float                @default(0)
  burnPct         Float                @default(0)
  alertLevel      String               @default("GREEN") // AlertLevel
  alert24hSent    Boolean              @default(false)
  alert48hSent    Boolean              @default(false)
  alert72hSent    Boolean              @default(false)
  status          String               @default("ACTIVE") // BurnStatus
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model AgentMoneyTransaction {
  id           String   @id @default(cuid())
  agentId      String
  agent        Agent    @relation(fields: [agentId], references: [id])
  coreTxnRef   String?
  amount       Float
  txnType      String // TxnType
  txnTimestamp DateTime
  source       String   @default("TRN_SUBMISSION") // TxnSource
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model TrnSubmission {
  id              String   @id @default(cuid())
  agentId         String
  agent           Agent    @relation(fields: [agentId], references: [id])
  trn             String
  declaredAmount  Float
  declaredType    String // TxnType
  structuralValid Boolean  @default(false)
  coreVerified    Boolean  @default(false)
  submittedAt     DateTime @default(now())
}

model Commission {
  id               String      @id @default(cuid())
  masterAgentId    String
  masterAgent      MasterAgent @relation(fields: [masterAgentId], references: [id])
  periodStart      DateTime
  periodEnd        DateTime
  totalDistributed Float
  lurAvg           Float
  baseFee          Float
  utilizationBonus Float
  totalCommission  Float
  status           String      @default("DRAFT") // CommissionStatus
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  disputes Dispute[]
}

model Dispute {
  id           String     @id @default(cuid())
  commissionId String
  commission   Commission @relation(fields: [commissionId], references: [id])
  raisedById   String
  raisedBy     User       @relation(fields: [raisedById], references: [id])
  description  String
  status       String     @default("OPEN") // DisputeStatus
  resolution   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String?
  entityId   String?
  details    String?
  timestamp  DateTime @default(now())
}

model RebalancerObservation {
  id                     String                @id @default(cuid())
  rebalancerId           String
  rebalancer             Rebalancer            @relation(fields: [rebalancerId], references: [id])
  agentId                String
  agent                  Agent                 @relation(fields: [agentId], references: [id])
  visitTxnId             String?               @unique
  visitTxn               RebalanceTransaction? @relation(fields: [visitTxnId], references: [id])
  customerTraffic        Int // 1-5 scale
  competitorFloatVisible Boolean               @default(false)
  zamtelBrandingVisible  Boolean               @default(true)
  agentAttitude          Int // 1-5 scale
  notes                  String?
  observedAt             DateTime              @default(now())
}

model SystemConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
